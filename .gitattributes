# Нормализация окончаний строк (проект разрабатывается в WSL рядом с Windows)
* text=auto

# Код и конфиги — всегда LF
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.sh text eol=lf

# Бинарные файлы
*.png binary
*.jpg binary
*.ico binary
*.db binary
