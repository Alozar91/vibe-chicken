# Сниппет для СИСТЕМНОГО nginx (не входит в docker compose проекта).
# SSL терминируется здесь; внутрь контейнера уходит обычный http.
# Вставьте блок location в существующий server { listen 443 ssl; ... }:
#
#     server {
#         listen 443 ssl;
#         server_name example.com;
#         # ... ssl_certificate, ssl_certificate_key, остальные location ...
#
#         include snippets/vibe-chicken.conf;   # ← этот файл
#     }

location /chicken {
    # Без URI в proxy_pass: браузерный путь /chicken/... передаётся целиком,
    # разбор префикса выполняет nginx внутри контейнера фронтенда.
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 10m;
}
