# Файл .env в корне проекта для docker compose (скопируйте: cp deploy/.env.example .env)

# Порт на хосте, куда смотрит системный nginx (location /chicken)
CHICKEN_PORT=8080

# Пароль администратора при первом запуске (создаётся только если в БД нет пользователей).
# ОБЯЗАТЕЛЬНО задайте свой — иначе compose не запустится.
CHICKEN_ADMIN_PASSWORD=change-me

# Кука сессии только по https (за системным nginx с SSL); локально без SSL ставьте false
CHICKEN_SESSION_HTTPS_ONLY=true

# Ключ подписи сессий (необязательно; иначе сгенерируется и сохранится в volume)
# CHICKEN_SECRET_KEY=

# Каталог данных (БД, бэкапы, secret.key).
# Не задан (по умолчанию) — данные в named volume vibe-chicken_chicken-data.
# Задан абсолютный путь — данные в обычном каталоге хоста, бэкапы доступны
# напрямую (rsync/restic/бэкап-агенты) без docker-команд. Пример:
# CHICKEN_DATA_DIR=/srv/chicken

# --- S3-синхронизация бэкапов (нужна только на платформах без постоянных
# томов — Timeweb App Platform и т.п.; на VPS с volume не задавайте) ---
# Timeweb Cloud → Object Storage → создать бакет + ключи доступа
CHICKEN_S3_ENDPOINT_URL=https://s3.timeweb.cloud
CHICKEN_S3_BUCKET=chicken-backups
CHICKEN_S3_ACCESS_KEY_ID=
CHICKEN_S3_SECRET_ACCESS_KEY=
CHICKEN_S3_REGION=us-east-1

# Префикс публикации фронтенда (App Platform: «/» — корень техдомена)
CHICKEN_BASE_PATH=/
