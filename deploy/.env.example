# Файл .env в корне проекта для docker compose (скопируйте: cp deploy/.env.example .env)

# Порт на хосте, куда смотрит системный nginx (location /chicken)
CHICKEN_PORT=8080

# Пароль администратора при первом запуске (создаётся только если в БД нет пользователей).
# ОБЯЗАТЕЛЬНО задайте свой — иначе compose не запустится.
CHICKEN_ADMIN_PASSWORD=change-me

# Кука сессии только по https (за системным nginx с SSL); локально без SSL ставьте false
CHICKEN_SESSION_HTTPS_ONLY=true

# Ключ подписи сессий (необязательно; иначе сгенерируется и сохранится в volume)
# CHICKEN_SECRET_KEY=
