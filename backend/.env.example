# Все переменные имеют префикс CHICKEN_.
# Скопируйте этот файл в .env и раскомментируйте нужное.

# Данные администратора (создаются при первом запуске, если в БД нет пользователей)
# CHICKEN_ADMIN_USERNAME=admin
# CHICKEN_ADMIN_PASSWORD=change-me

# Ключ подписи сессий (иначе сгенерируется в backend/data/secret.key)
# CHICKEN_SECRET_KEY=

# Включить в проде за nginx с SSL (кука только по https)
# CHICKEN_SESSION_HTTPS_ONLY=true

# Разрешённые origins для CORS (формат JSON)
# CHICKEN_CORS_ORIGINS=["https://chicken.example.com"]

# Адрес БД (по умолчанию SQLite в backend/data/app.db)
# CHICKEN_DB_URL=sqlite:///./data/app.db
